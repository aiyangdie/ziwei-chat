# 复制为 .env.local 后填写

# Agnes AI — https://www.agnes-ai.com/zh-Hans/docs/quickstart
AI_PROVIDER=agnes
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
# 若 Node 报 self-signed certificate，本地开发可设为 1
AGNES_INSECURE_TLS=1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
